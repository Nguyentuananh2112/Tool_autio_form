APP_NAME="Smart Survey Auto-Filler"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/auto_form
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

REDIS_URL=redis://localhost:6379/0

# Sinh khóa: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-random-string-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

FORM_FETCH_TIMEOUT_SECONDS=20
SPSS_PREVIEW_SAMPLE_SIZE=200
MAX_CAMPAIGN_TARGET=10000
