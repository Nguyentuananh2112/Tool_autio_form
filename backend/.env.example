# Chỉ cần khi phát triển. Bản cài đặt cho người dùng chạy với giá trị mặc định.
ENVIRONMENT=development
DEBUG=true
HOST=127.0.0.1
PORT=8765
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Mặc định: %APPDATA%\Auto-Form\auto_form.db. Bỏ dấu # để đổi (KHÔNG để DATA_DIR rỗng: sẽ thành thư mục hiện tại)
# DATA_DIR=D:\AutoFormData
# DATABASE_URL=sqlite+aiosqlite:///D:/AutoFormData/auto_form.db
DB_ECHO=false

# Chỉ dùng khi phát triển; bản phát hành lưu key trong kho bảo mật của Windows
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

FORM_FETCH_TIMEOUT_SECONDS=20
SPSS_PREVIEW_SAMPLE_SIZE=200
MAX_CAMPAIGN_TARGET=10000
